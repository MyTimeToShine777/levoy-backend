# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ── Server ──
PORT=3000
HOST=0.0.0.0

# ── Database ──
PG_HOST=localhost
PG_PORT=5432
PG_DB=levoy
PG_USER=postgres
PG_PASSWORD=
DATABASE_URL=postgres://postgres:password@localhost:5432/levoy

# ── Auth ──
JWT_SECRET=
# Sign-in is by a 6-digit code emailed through medivoy.api (no passwords).
BOOTSTRAP_ADMIN_EMAIL=
MEDIVOY_API_BASE_URL=https://api.medivoy.ae
OTP_RESEND_SECONDS=60
# Platform owners (comma separated). Defaults to BOOTSTRAP_ADMIN_EMAIL.
PLATFORM_ADMIN_EMAILS=
# Each customer lives in its own schema. PG_SCHEMA is the original workspace's schema; the platform schema holds customers, plans and subscriptions.
PG_SCHEMA=levoy
PLATFORM_SCHEMA=levoy_platform
TENANT_POOL_MAX=4
INTERNAL_JOBS_SECRET=

# ── Features ──
ENABLE_PUSH_NOTIFICATIONS=false
STORAGE_DRIVER=local

# ── Cloudflare R2 storage ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ENDPOINT=

# ── Firebase (push notifications) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_ANDROID_API_KEY=
FIREBASE_SENDER_ID=

# ── SMTP email ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
