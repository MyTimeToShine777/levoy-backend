{
  "name": "levoy-backend",
  "version": "1.0.0",
  "description": "Callio API — Express + PostgreSQL (Prisma schema/migrations)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "lint": "eslint src scripts test",
    "test": "node --test test/*.test.js",
    "characterize": "node scripts/characterize.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pg": "^8.13.0",
    "stripe": "^23.0.0",
    "uuid": "^14.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prisma": "^6.19.3"
  }
}
