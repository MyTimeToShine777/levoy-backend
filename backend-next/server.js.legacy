app.put('/api/notifications/read-all', authMW, async (req, res) => {
  try {
    await q('UPDATE notifications SET is_read = true WHERE user_id = $1', [req.userId]);
    res.json({ readAll: true });
  } catch (e) { res.status(500).json({ detail: 'Error' }); }
});

app.delete('/api/notifications/:notifId', authMW, async (req, res) => {
  try {
    await q('DELETE FROM notifications WHERE id = $1 AND user_id = $2', [req.params.notifId, req.userId]);
    res.json({ deleted: true });
  } catch (e) { res.status(500).json({ detail: 'Error' }); }
});

// ─── Team Analytics ───
app.get('/api/teams/:teamId/analytics', authMW, async (req, res) => {
  try {
    // Verify membership
    if (req.userRole === 'agent') {
      const m = await q('SELECT 1 FROM team_members WHERE team_id = $1 AND user_id = $2', [req.params.teamId, req.userId]);
      if (m.rows.length === 0) return res.status(403).json({ detail: 'Not a member' });
    }
    // t.name is not aggregated, so it must appear in GROUP BY (Postgres 42803 otherwise).
    const team = await q('SELECT t.name, COUNT(DISTINCT tm.user_id) as members FROM teams t JOIN team_members tm ON tm.team_id = t.id WHERE t.id = $1 GROUP BY t.name', [req.params.teamId]);
    if (team.rows.length === 0) return res.status(404).json({ detail: 'Team not found' });

    const today = new Date();
    const ts = new Date(today.getFullYear(), today.getMonth(), today.getDate()).toISOString();
    const te = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 1).toISOString();

    const memberIds = await q('SELECT user_id FROM team_members WHERE team_id = $1', [req.params.teamId]);
    const ids = memberIds.rows.map(r => r.user_id);

    // Team calls today
    const callsSql = `SELECT COUNT(*) as cnt, SUM(duration_seconds) as dur, COUNT(DISTINCT phone_number) as uniq, COUNT(CASE WHEN direction='incoming' THEN 1 END) as inc, COUNT(CASE WHEN direction='outgoing' THEN 1 END) as out, COUNT(CASE WHEN status='missed' THEN 1 END) as missed, COUNT(CASE WHEN status='rejected' THEN 1 END) as rej FROM call_events WHERE timestamp >= $1 AND timestamp < $2 AND user_id = ANY($3)`;
    const callsR = await q(callsSql, [ts, te, ids]);
    const cRow = callsR.rows[0];

    // Per-member stats
    const members = await q('SELECT u.id, u.name, u.email, u.role, u.avatar_url FROM users u JOIN team_members tm ON tm.user_id = u.id WHERE tm.team_id = $1', [req.params.teamId]);
    const memberStats = [];
    for (const m of members.rows) {
      const stats = await q(`SELECT COUNT(*) as total, SUM(duration_seconds) as dur, COUNT(DISTINCT phone_number) as uniq, COUNT(CASE WHEN status='connected' THEN 1 END) as conn FROM call_events WHERE user_id = $1 AND timestamp >= $2 AND timestamp < $3`, [m.id, ts, te]);
      const s = stats.rows[0];
      memberStats.push({
        id: m.id, name: m.name, email: m.email, role: m.role, avatar_url: m.avatar_url,
        total_calls: parseInt(s.total) || 0,
        total_duration: parseInt(s.dur) || 0,
        unique_contacts: parseInt(s.uniq) || 0,
        connected_calls: parseInt(s.conn) || 0,
      });
    }

    res.json({
      team_name: team.rows[0].name,
      member_count: parseInt(team.rows[0].members),
      today: {
        total_calls: parseInt(cRow.cnt) || 0,
        total_duration: parseInt(cRow.dur) || 0,
        unique_contacts: parseInt(cRow.uniq) || 0,
        incoming: parseInt(cRow.inc) || 0,
        outgoing: parseInt(cRow.out) || 0,
        missed: parseInt(cRow.missed) || 0,
        rejected: parseInt(cRow.rej) || 0,
      },
      members: memberStats.sort((a, b) => b.total_calls - a.total_calls),
    });
  } catch (e) { console.error('Team analytics error:', e); res.status(500).json({ detail: 'Error' }); }
});

// ─── Export Center ───
app.post('/api/exports', authMW, async (req, res) => {
  const { type, params } = req.body;
  if (!type) return res.status(400).json({ detail: 'type required' });

  try {
    const isAgent = req.userRole === 'agent';
    let where = isAgent ? ' WHERE user_id = $1' : '';
    const baseParams = isAgent ? [req.userId] : [];

    let csv = '';
    let filename = '';

    if (type === 'calls') {
      const limit = Math.min(Math.max(parseInt(params.limit) || 10000, 1), 50000);
      const offset = parseInt(params.offset) || 0;
      const order = params.order || 'timestamp';
      const dir = params.dir || 'DESC';
      const cols = 'id, phone_number, direction, status, duration_seconds, timestamp, caller_id, notes, is_pinned';
      let sql = `SELECT ${cols} FROM call_events${where} ORDER BY ${order} ${dir} LIMIT $${baseParams.length + 1} OFFSET $${baseParams.length + 2}`;
      const p = [...baseParams, limit, offset];
      const r = await q(sql, p);
      csv = [cols].concat(r.rows.map(row => Object.values(row).join(','))).join('\n');
      filename = `calls_export_${Date.now()}.csv`;
    } else if (type === 'calls_summary') {
      const statsR = await q(`SELECT COUNT(*) as total, SUM(duration_seconds) as dur, COUNT(DISTINCT phone_number) as uniq, COUNT(CASE WHEN direction='incoming' THEN 1 END) as inc, COUNT(CASE WHEN direction='outgoing' THEN 1 END) as out, COUNT(CASE WHEN status='missed' THEN 1 END) as missed, COUNT(CASE WHEN status='rejected' THEN 1 END) as rej, COUNT(CASE WHEN status='connected' THEN 1 END) as conn FROM call_events${where}`, baseParams);
      const s = statsR.rows[0];
      csv = `Metric,Value\nTotal Calls,${s.total}\nTotal Duration (${Math.floor(parseInt(s.dur)/60)}m),${s.dur}\nUnique Contacts,${s.uniq}\nIncoming,${s.inc}\nOutgoing,${s.out}\nMissed,${s.missed}\nRejected,${s.rej}\nConnected,${s.conn}\n`;
      filename = `calls_summary_${Date.now()}.csv`;
    } else if (type === 'leads') {
      const limit = Math.min(Math.max(parseInt(params.limit) || 10000, 1), 50000);
      const cols = 'id, name, phone, email, status, source, priority, owner_id, assigned_to, notes, created_at, updated_at';
      const leadWhere = isAgent ? ' WHERE owner_id = $1' : ' WHERE 1=1';
      let sql = `SELECT ${cols} FROM leads${leadWhere} ORDER BY updated_at DESC LIMIT $${isAgent ? 2 : 1} OFFSET 0`;
      const r = await q(sql, isAgent ? [req.userId] : []);
      csv = [cols].concat(r.rows.map(row => Object.values(row).join(','))).join('\n');
      filename = `leads_export_${Date.now()}.csv`;
    } else if (type === 'leads_pipeline') {
      const statuses = ['new','contacted','qualified','proposal','negotiation','converted','lost'];
      const leadWhere = isAgent ? ' WHERE owner_id = $1' : ' WHERE 1=1';
      csv = 'Status,Count\n';
      for (const st of statuses) {
        const r = await q(`SELECT COUNT(*) FROM leads${leadWhere} AND status = $2`, isAgent ? [req.userId, st] : [st]);
        csv += `${st},${r.rows[0].count}\n`;
      }
      filename = `leads_pipeline_${Date.now()}.csv`;
    }

    // Save export record
    const fp = `/uploads/exports/${filename}`;
    const dir = path.join(__dirname, 'uploads', 'exports');
    if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });
    fs.writeFileSync(path.join(dir, filename), csv);
    await q('INSERT INTO exports (user_id, type, params, file_path) VALUES ($1, $2, $3, $4)', [req.userId, type, JSON.stringify(params), fp]);

    res.json({ export_id: 'exp_' + Date.now(), type, filename, file_path: fp, rows: csv.split('\n').length - 1 });
  } catch (e) { console.error('Export error:', e); res.status(500).json({ detail: 'Error' }); }
});

app.get('/api/exports', authMW, async (req, res) => {
  try {
    const r = await q('SELECT * FROM exports WHERE user_id = $1 ORDER BY created_at DESC LIMIT 50', [req.userId]);
    res.json(r.rows.map(e => ({ id: e.id, type: e.type, params: e.params, created_at: e.created_at })));
  } catch (e) { res.status(500).json({ detail: 'Error' }); }
});

app.get('/api/exports/:expId/file', authMW, async (req, res) => {
  try {
    const r = await q('SELECT file_path FROM exports WHERE id = $1 AND user_id = $2', [req.params.expId, req.userId]);
    if (r.rows.length === 0) return res.status(404).json({ detail: 'Not found' });
    const fp = path.join(__dirname, r.rows[0].file_path);
    if (!fs.existsSync(fp)) return res.status(404).json({ detail: 'File not found' });
    res.download(fp);
  } catch (e) { res.status(500).json({ detail: 'Error' }); }
});

// ─── Health & Static Files ───
app.get('/health', (req, res) => res.json({ status: 'ok' }));
// Bare "/" is a friendly landing page rather than a one-line JSON blob, so
// hitting the API host in a browser shows something useful.
// Browsers asking for HTML get HTML; API clients still get JSON.
app.get('/', (req, res) => {
  if (!req.accepts('html')) {
    return res.json({ name: 'Levoy Clone API', version: '1.0.0', status: 'running' });
  }
  res.type('html').send(`<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Levoy API</title>
<style>
 body{margin:0;padding:3rem 1.5rem;font:15px/1.6 system-ui,-apple-system,Segoe UI,sans-serif;
      background:#f5f6fa;color:#0b1220;display:flex;justify-content:center}
 .w{max-width:640px;width:100%}
 .pill{display:inline-block;background:#ecfdf5;color:#047857;border:1px solid #a7f3d0;
       padding:2px 10px;border-radius:999px;font-size:12px;font-weight:700}
 h1{margin:14px 0 4px;font-size:26px;letter-spacing:-.02em}
 code{background:#fff;border:1px solid #e6e8f0;border-radius:6px;padding:1px 6px;font-size:13px}
 pre{background:#fff;border:1px solid #e6e8f0;border-radius:12px;padding:14px;overflow:auto;font-size:13px}
 ul{padding-left:18px} a{color:#4f46e5}
</style></head><body><div class="w">
<span class="pill">API is running</span>
<h1>Levoy Clone API</h1>
<p>The JSON service behind the dashboard. The dashboard itself is the web app on port&nbsp;3000.</p>
<pre>GET  /health          liveness probe
GET  /api/version     version info</pre>
<p>Everything under <code>/api</code> requires a bearer token:</p>
<pre>POST /api/auth/login    {"email":"...","password":"..."}
Authorization: Bearer &lt;token&gt;</pre>
<p>Full endpoint reference: <a href="http://168.144.120.169:3000/api-doc">/api-doc</a></p>
</div></body></html>`);
});

// Hitting /api bare used to 404 with Express's HTML error page.
app.get('/api', (req, res) =>
  res.json({
    name: 'Levoy Clone API',
    version: '1.0.0',
    hint: 'Authenticate with POST /api/auth/login, then send "Authorization: Bearer <token>".',
    docs: '/api-doc (on the dashboard host)',
  })
);

// Uploaded FILES are not served statically.
//
// This mount used to expose /uploads/** with no auth at all, which published
// every call recording to anyone who could guess or obtain the URL — the
// authenticated GET /api/recordings/:id/file route was gated, but this one
// defeated it. Recordings are served only through the authenticated endpoint.
//
// Avatars are a different case: they appear in list views for other users (an
// assignee avatar inside a lead row), so they are exposed under a separate
// path rather than the recordings directory.
app.use(
  '/uploads/avatars',
  express.static(path.join(UPLOADS_DIR, 'avatars'), {
    fallthrough: false,
    index: false,
    dotfiles: 'ignore',
    maxAge: '7d',
  })
);
app.use(
  '/uploads',
  (req, res) =>
    res.status(404).json({
      detail: 'Direct file access is disabled. Use the authenticated API endpoints.',
    })
);

const PORT = process.env.PORT || 3001;
const HOST = process.env.HOST || '0.0.0.0';

initDB().then(() => {
  app.listen(PORT, HOST, () => console.log(`API running on http://${HOST}:${PORT}`));
}).catch(e => { console.error('DB init failed:', e); process.exit(1); });

process.on('SIGTERM', async () => { await pool.end(); process.exit(0); });
process.on('SIGINT', async () => { await pool.end(); process.exit(0); });
