app.put('/api/whatsapp-templates/:tmplId', authMW, async (req, res) => {
  const { name, category, language, content, variables, is_active } = req.body;
  try {
    const fields = [];
    const vals = [];
    let idx = 1;
    for (const [k, v] of Object.entries({ name, category, language, content, is_active })) {
      if (v !== undefined) { fields.push(`${k} = $${idx}`); vals.push(v); idx++; }
    }
    if (variables !== undefined) { fields.push(`variables = $${idx}`); vals.push(JSON.stringify(variables)); idx++; }
    if (fields.length === 0) return res.status(400).json({ detail: 'No fields to update' });
    vals.push(req.params.tmplId);
    const r = await q(`UPDATE whatsapp_templates SET ${fields.join(', ')} WHERE id = $${idx} RETURNING *`, vals);
    const t = r.rows[0];
    res.json({ id: t.id, name: t.name, category: t.category, language: t.language, content: t.content, variables: t.variables ? JSON.parse(t.variables) : null, is_active: t.is_active, created_at: t.created_at });
  } catch (e) { res.status(500).json({ detail: 'Error' }); }
});

app.delete('/api/whatsapp-templates/:tmplId', authMW, async (req, res) => {
  try {
    await q('DELETE FROM whatsapp_templates WHERE id = $1 AND user_id = $2', [req.params.tmplId, req.userId]);
    res.json({ deleted: true });
  } catch (e) { res.status(500).json({ detail: 'Error' }); }
});

