app.post('/api/whatsapp-templates', authMW, async (req, res) => {
  const { name, category, language, content, variables } = req.body;
  if (!name || !content) return res.status(400).json({ detail: 'name and content required' });
  try {
    const r = await q(`INSERT INTO whatsapp_templates (user_id, name, category, language, content, variables) VALUES ($1, $2, $3, $4, $5, $6) RETURNING *`,
      [req.userId, name, category || null, language || 'en', content, variables ? JSON.stringify(variables) : null]);
    const t = r.rows[0];
    res.status(201).json({ id: t.id, name: t.name, category: t.category, language: t.language, content: t.content, variables: t.variables ? JSON.parse(t.variables) : null, is_active: t.is_active, created_at: t.created_at });
  } catch (e) { res.status(500).json({ detail: 'Error' }); }
