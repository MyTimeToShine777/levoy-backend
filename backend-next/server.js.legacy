app.get('/api/whatsapp-templates', authMW, async (req, res) => {
  try {
    const r = await q('SELECT * FROM whatsapp_templates WHERE user_id = $1 ORDER BY created_at DESC', [req.userId]);
    res.json(r.rows.map(t => ({ id: t.id, name: t.name, category: t.category, language: t.language, content: t.content, variables: t.variables, is_active: t.is_active, created_at: t.created_at })));
  } catch (e) { res.status(500).json({ detail: 'Error' }); }
