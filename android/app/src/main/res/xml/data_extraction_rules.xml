<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device-to-device transfer carry only the call-history backup file.
     The sign-in token and settings (shared preferences) are never included. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="backups" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="backups" />
    </device-transfer>
</data-extraction-rules>
