<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/dashboardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <!-- Greeting -->
                <TextView
                    android:id="@+id/tvGreeting"
                    style="@style/Text.ScreenTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvGreetingSub"
                    style="@style/Text.RowSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />

                <!-- Today: 2x2 stat grid, each with a delta/hint line -->
                <TextView
                    style="@style/Text.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/dash_today" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <include
                        android:id="@+id/statCallsToday"
                        layout="@layout/view_stat_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp" />

                    <include
                        android:id="@+id/statConnected"
                        layout="@layout/view_stat_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <include
                        android:id="@+id/statMissed"
                        layout="@layout/view_stat_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp" />

                    <include
                        android:id="@+id/statAvgDuration"
                        layout="@layout/view_stat_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <include
                        android:id="@+id/statTalkTime"
                        layout="@layout/view_stat_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp" />

                    <include
                        android:id="@+id/statConnectRate"
                        layout="@layout/view_stat_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <!-- Pipeline -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/pipelineHeader"
                        layout="@layout/view_section_header" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/pipelineCard"
                    style="@style/Widget.Callio.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/pipelineContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvPipelineEmpty"
                    style="@style/Text.RowSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/empty_leads_body"
                    android:visibility="gone" />

                <!-- Recent calls -->
                <LinearLayout
                    android:id="@+id/recentCallsHeaderContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/recentCallsHeader"
                        layout="@layout/view_section_header" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/recentCallsCard"
                    style="@style/Widget.Callio.Card.Flat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap">

                    <LinearLayout
                        android:id="@+id/recentCallsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvRecentCallsEmpty"
                    style="@style/Text.RowSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/dash_no_calls_hint"
                    android:visibility="gone" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />
            </LinearLayout>
        </ScrollView>

        <include
            android:id="@+id/emptyState"
            layout="@layout/view_empty_state" />

        <include
            android:id="@+id/errorState"
            layout="@layout/view_error_state" />
    </FrameLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
