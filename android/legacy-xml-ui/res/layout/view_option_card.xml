<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/optionCard"
    style="@style/Widget.Callio.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/card_padding">

        <ImageView
            android:id="@+id/optionIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_avatar"
            android:padding="8dp"
            android:src="@drawable/ic_calls"
            android:tint="@color/accent"
            android:contentDescription="@string/cd_leading_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/optionTitle"
                style="@style/Text.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—" />

            <TextView
                android:id="@+id/optionSubtitle"
                style="@style/Text.RowSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:lineSpacingMultiplier="1.15"
                android:text="—" />

            <TextView
                android:id="@+id/optionWarning"
                style="@style/Text.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sim_skip_sub"
                android:textColor="@color/danger"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/optionChevron"
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/text_tertiary"
            android:contentDescription="@string/more" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
