<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/moreRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/moreIcon"
        android:layout_width="@dimen/icon_md"
        android:layout_height="@dimen/icon_md"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_settings"
        android:tint="@color/text_secondary"
        android:contentDescription="@string/cd_leading_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/moreTitle"
            style="@style/Text.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/moreDescription"
            style="@style/Text.RowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_tertiary" />
    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/icon_md"
        android:layout_height="@dimen/icon_md"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/text_tertiary"
        android:contentDescription="@string/more" />

</LinearLayout>
