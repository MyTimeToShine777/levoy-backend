<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/errorState"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="40dp"
    android:paddingEnd="40dp"
    android:paddingBottom="64dp"
    android:visibility="gone">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:alpha="0.35"
        android:background="@drawable/bg_avatar_circle"
        android:padding="12dp"
        android:src="@drawable/ic_sync"
        android:tint="@color/text_tertiary"
        android:contentDescription="@string/error_title" />

    <TextView
        android:id="@+id/errorTitle"
        style="@style/Text.EmptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/error_title" />

    <TextView
        android:id="@+id/errorBody"
        style="@style/Text.EmptyBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/error_body" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/errorRetry"
        style="@style/Widget.Callio.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/retry" />

</LinearLayout>
