<?xml version="1.0" encoding="utf-8"?>
<!--
    In-call overlay. Drawn by QuickActionOverlay via WindowManager with
    TYPE_APPLICATION_OVERLAY, so the root must not be match_parent height —
    the window is wrap_content and centred low on screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            style="@style/Text.Eyebrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/quick_action_in_call" />

        <TextView
            android:id="@+id/tvOverlayTimer"
            style="@style/Text.StatLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/accent" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvOverlayNumber"
        style="@style/Text.SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="20sp"
        android:text="—" />

    <TextView
        android:id="@+id/tvOverlayHint"
        style="@style/Text.RowSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_tertiary"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/btnOverlaySaveContact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_surface_variant"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:src="@drawable/ic_contact"
                android:tint="@color/accent"
                android:contentDescription="@string/quick_action_save_contact" />

            <TextView
                style="@style/Text.RowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:text="@string/quick_action_save_contact" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnOverlayViewDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_surface_variant"
            android:layout_marginStart="8dp"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:src="@drawable/ic_reports"
                android:tint="@color/accent"
                android:contentDescription="@string/quick_action_view_details" />

            <TextView
                style="@style/Text.RowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:text="@string/quick_action_view_details" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btnOverlayDismiss"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:text="@string/quick_action_dismiss"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
