<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/qualityScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/qualityContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <!-- Agent identity -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvQualityInitials"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_avatar"
                        android:gravity="center"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent"
                        android:includeFontPadding="false"
                        android:text="—" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvQualityAgentName"
                            style="@style/Text.ScreenTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="—" />

                        <TextView
                            android:id="@+id/tvQualityAgentEmail"
                            style="@style/Text.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Headline QA score -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Callio.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            style="@style/Text.Eyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quality_score" />

                        <TextView
                            android:id="@+id/tvQualityScore"
                            style="@style/Text.StatValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="40sp"
                            android:textColor="@color/accent"
                            android:text="—" />

                        <TextView
                            android:id="@+id/tvQualityScoreHint"
                            style="@style/Text.StatLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_tertiary" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal"
                            android:baselineAligned="false">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvQuality30d"
                                    style="@style/Text.RowTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFeatureSettings="tnum"
                                    android:text="—" />

                                <TextView
                                    style="@style/Text.StatLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/quality_30d" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvQualityReviews"
                                    style="@style/Text.RowTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFeatureSettings="tnum"
                                    android:text="—" />

                                <TextView
                                    style="@style/Text.StatLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/quality_reviews_count" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvQualityViolations"
                                    style="@style/Text.RowTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFeatureSettings="tnum"
                                    android:text="—" />

                                <TextView
                                    style="@style/Text.StatLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/quality_violations" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvQualityRange"
                            style="@style/Text.StatLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="@color/text_tertiary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Per-category bars -->
                <TextView
                    android:id="@+id/tvCategoriesHeader"
                    style="@style/Text.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/quality_categories" />

                <TextView
                    android:id="@+id/tvWorstCategory"
                    style="@style/Text.RowSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/accent"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Callio.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap">

                    <LinearLayout
                        android:id="@+id/categoriesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvNoCategories"
                    style="@style/Text.RowSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/empty_quality_body"
                    android:visibility="gone" />

                <!-- Recent reviews -->
                <TextView
                    android:id="@+id/tvReviewsHeader"
                    style="@style/Text.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/quality_recent_reviews" />

                <LinearLayout
                    android:id="@+id/reviewsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap"
                    android:orientation="vertical" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />
            </LinearLayout>
        </ScrollView>

        <include
            android:id="@+id/emptyState"
            layout="@layout/view_empty_state" />

        <include
            android:id="@+id/errorState"
            layout="@layout/view_error_state" />
    </FrameLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
