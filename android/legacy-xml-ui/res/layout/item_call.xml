<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed row, hairline divider, trailing chevron per the reference. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/callRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/row_min_height"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/ivDirection"
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_outgoing"
            android:tint="@color/info"
            android:contentDescription="@string/calls" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvContact"
                style="@style/Text.RowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="—" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvStatus"
                    style="@style/Text.RowSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:text="·"
                    android:textSize="13sp"
                    android:textColor="@color/text_tertiary" />

                <TextView
                    android:id="@+id/tvDirection"
                    style="@style/Text.RowSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="—" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvTime"
                style="@style/Text.RowSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvDuration"
                style="@style/Text.RowSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/text_tertiary" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/callMetaRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPinnedBadge"
            style="@style/Text.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_accent_soft"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/call_pinned"
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvNotePreview"
            style="@style/Text.RowSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_tertiary"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/callDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:layout_marginStart="36dp"
        android:layout_marginTop="12dp"
        android:background="@color/divider" />

</LinearLayout>
