<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/teamRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/tvTeamInitials"
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:includeFontPadding="false"
            android:text="—" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTeamName"
                style="@style/Text.RowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="—" />

            <TextView
                android:id="@+id/tvTeamEmail"
                style="@style/Text.RowSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvTeamRole"
                style="@style/Text.RowSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge_rounded"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textSize="11sp"
                android:textColor="@color/info" />

            <LinearLayout
                android:id="@+id/teamWorkloadBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTeamOpenLeads"
                        style="@style/Text.StatLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFeatureSettings="tnum" />

                    <TextView
                        android:id="@+id/tvTeamCallsToday"
                        style="@style/Text.StatLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFeatureSettings="tnum" />

                    <TextView
                        android:id="@+id/tvTeamTotalCalls"
                        style="@style/Text.StatLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:fontFeatureSettings="tnum" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/teamCapacityBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stat_bar_height"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_bar_horizontal" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTeamLastActive"
                style="@style/Text.RowSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:textColor="@color/text_tertiary" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/teamDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:layout_marginStart="52dp"
        android:layout_marginTop="12dp"
        android:background="@color/divider" />

</LinearLayout>
