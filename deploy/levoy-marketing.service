[Unit]
# Rapid crash-loops back off instead of hot-spinning the CPU.
StartLimitIntervalSec=60
StartLimitBurst=5
Description=Levoy marketing site (Next.js production build, port 3002)
Documentation=file:///root/callyzer-clone/README.md
After=network.target
# Deliberately NOT Requires=postgresql.service: the marketing site never touches
# the DB, so a Postgres blip must not take the site down with it.

[Service]
Type=simple
User=root
WorkingDirectory=/root/callyzer-clone/marketing-site

Environment=NODE_ENV=production
Environment=PORT=3002
Environment=HOSTNAME=0.0.0.0
Environment=PATH=/root/.hermes/tools/node-26.7.0-linux-x64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Same fail-fast build guard as the frontend: never block boot on a build.
ExecStartPre=/bin/bash -c 'test -f /root/callyzer-clone/marketing-site/.next/BUILD_ID || { echo "levoy-marketing: missing production build (.next/BUILD_ID). Run: make -C /root/callyzer-clone build"; exit 1; }'

ExecStart=/root/.hermes/tools/node-26.7.0-linux-x64/bin/npx next start -p 3002

Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
KillMode=mixed

StandardOutput=journal
StandardError=journal
SyslogIdentifier=levoy-marketing

[Install]
WantedBy=multi-user.target
